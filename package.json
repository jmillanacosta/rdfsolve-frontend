{
  "name": "schema-diagram-component",
  "version": "0.1.0",
  "description": "Reusable schema diagram web component (TypeScript + d3) for RDF schema visualization and SPARQL composition",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/demo-entry.ts --bundle --outfile=demo/dist/bundle.js --format=esm --target=es2020 --sourcemap",
    "build:api": "esbuild src/api-entry.ts --bundle --outfile=demo/dist/bundle.js --format=esm --target=es2020 --sourcemap",
    "manifest": "node -e \"const fs=require('fs');const f=fs.readdirSync('demo').filter(x=>x.endsWith('.jsonld'));const m=f.map((x,i)=>({id:x.replace(/\\.jsonld$/,''),file:x,name:x.replace(/\\.jsonld$/,'').replace(/[._]/g,' ').replace(/\\b\\w/g,c=>c.toUpperCase())}));fs.writeFileSync('demo/manifest.json',JSON.stringify(m,null,2));console.log(m.length+' entries')\"",
    "watch": "esbuild src/demo-entry.ts --bundle --outfile=demo/dist/bundle.js --format=esm --target=es2020 --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "echo 'Run npm install'"
  },
  "keywords": [
    "rdf",
    "diagram",
    "d3",
    "web-component",
    "schema"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.8.4"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "esbuild": "^0.19.12",
    "typescript": "^5.3.3"
  }
}
